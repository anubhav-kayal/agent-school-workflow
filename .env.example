# Copy to .env for local development. Never commit real values.
ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://admissionpilot:admissionpilot@localhost:5433/admissionpilot
TEST_DATABASE_URL=postgresql+asyncpg://admissionpilot:admissionpilot@localhost:5433/admissionpilot_test
REDIS_URL=redis://localhost:6380/0
SESSION_SECRET=change-me

# Safety: keep true unless explicitly approved.
DRY_RUN=true
GLOBAL_KILL_SWITCH=false

# Anthropic
ANTHROPIC_API_KEY=
USD_TO_INR=84.0
CACHE_TTL_ASSISTANT=5m
# Override a model per agent, e.g.:
# AGENTS__OPTIMIZER__MODEL=claude-sonnet-5-5

# Meta (System User token; app secret validates webhooks)
META_GRAPH_VERSION=v24.0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Google Ads
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
